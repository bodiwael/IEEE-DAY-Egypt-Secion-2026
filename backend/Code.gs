// IEEE Day 2026 backend (Google Sheet = database, MailApp = emails). Generated by build.py - do not edit STAFF by hand.
const STAFF={"R1": "bca197e33488be345e638a714a71d8d985b606299247aaca57dd5fd7abcb7241", "R2": "50c34049c9c7c6193f32dcba60b1c6d4a9d97aa25e17ed59ef6db8d579560bba", "R3": "c41a083929b0fd33b3391066a6decc0deb6fa89c9f5c20c647d0c9eb16fdbd7a", "R4": "ff7e5923334acc18dc7fb4438f87e838e2ce79cad0e3fe28333716e169210d28", "R5": "89bef8ccaa163494d590f03e4cbc4b95bb4deaf1fd0c02df51ffe305849c29d4", "R6": "552525ed47b9b0aaddefaaba84cf54850f76ecf8288adfa12f97c368fc7ecbce", "R7": "9b012aac7ce381c8530f835e2ef6e78550518ed1158490fb24e8555ad3f70521", "R8": "de9c9ff0bcf8f69a12ed784c7fdc8475f74823a54a87d53caafdb896ee29aea1", "O1": "53eb561cb3b8ce93402e45ff54894ce08240d8e84382133de4e48fd93eb18c80", "G1": "565b54f8fce28656594e09c8d5dcac0993aa242829251f77b9618a5fe32b2987", "G2": "d192ce65108743dbcc9378e9dd9599313df9a165003683ea804d50ae75af44ea", "K1": "0a7022df61d134e2d002defc9b80163c58c01da93858ef033411334ae3011e2e", "L1": "11ee815f525946fc77680d821295a88df1db9147488465f17444840a5ff238c3", "ACT1": "1848a3360236f8af489448692609cd0777bcd61bda112c7a21cc6b7bb40dc36b", "ACT2": "c159a107fb8e648b43f9fc6957cdb33236d2c6d1d1b755d0a1f1f18401fe32cd", "ACT3": "7f21396c2e94915fc212600116af8321869560fa74f5b8e9e77332499df50810", "TB1": "3e5bae5e9917ccb79b0b7415c864852d32980d0ce2e820a27b53f8dc8c7ce3fe", "ADMIN": "08495198ff34b39d4f05788a32efa551905fabfb4b6b7ced98030ab3d2e5f99a"};
const REPORT_CC='Malk@ieee.org,mmossad2512@ieee.org';   // gets every bus report
const TEST_TO='';   // while testing put YOUR email: ALL emails go only to you. Set '' before the event!
const MAX_TRIES=5;
function sh_(n,h){const ss=SpreadsheetApp.getActiveSpreadsheet();let s=ss.getSheetByName(n);if(!s){s=ss.insertSheet(n);s.appendRow(h)}return s}
const out_=o=>ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
const esc_=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function doGet(){return out_({ok:true,msg:'IEEE Day backend is running'})}
function doPost(e){
  let b;try{b=JSON.parse(e.postData.contents)}catch(x){return out_({error:'bad'})}
  if(!b.sid||STAFF[b.sid]!==b.auth)return out_({error:'auth'});
  const L=LockService.getScriptLock();L.waitLock(28000);
  try{
    const E=sh_('Events',['id','json']),M=sh_('Mail',['evId','kind','status','tries','error']);
    const n=E.getLastRow(),rows=n>1?E.getRange(2,1,n-1,2).getValues():[],have={};rows.forEach(r=>have[r[0]]=1);
    const add=[],mail=[];
    (b.events||[]).forEach(ev=>{if(have[ev.id])return;have[ev.id]=1;delete ev.s;const j=JSON.stringify(ev);add.push([ev.id,j]);rows.push([ev.id,j]);
      if(ev.st==='mail'||ev.st==='report')mail.push([ev.id,ev.st,'todo',0,''])});
    if(add.length)E.getRange(E.getLastRow()+1,1,add.length,2).setValues(add);
    if(mail.length)M.getRange(M.getLastRow()+1,1,mail.length,5).setValues(mail);
    pump_(10);
    return out_({events:rows.map(r=>JSON.parse(r[1])),mail:stat_()});
  }finally{L.releaseLock()}
}
function pump_(max){
  const M=sh_('Mail',[]),n=M.getLastRow();if(n<2)return;
  const d=M.getRange(2,1,n-1,5).getValues();if(!d.some(r=>r[2]==='todo'||(r[2]==='fail'&&r[3]<MAX_TRIES)))return;
  const E=sh_('Events',[]),EV={};E.getRange(2,1,E.getLastRow()-1,2).getValues().forEach(r=>EV[r[0]]=r[1]);
  const t0=Date.now();let sent=0;
  for(let i=0;i<d.length&&sent<max&&Date.now()-t0<20000;i++){const r=d[i];
    if(r[2]==='sent'||(r[2]==='fail'&&r[3]>=MAX_TRIES))continue;
    if(MailApp.getRemainingDailyQuota()<1)break;
    try{const ev=JSON.parse(EV[r[0]]);
      if(r[1]==='mail')sendPerson_(ev);else sendReport_(ev);
      M.getRange(i+2,3,1,3).setValues([['sent',r[3],'']]);sent++;
    }catch(x){M.getRange(i+2,3,1,3).setValues([['fail',r[3]+1,String(x.message).slice(0,150)]])}
  }
}
const when_=ts=>Utilities.formatDate(new Date(+ts),'Africa/Cairo','dd MMM yyyy, HH:mm');
function sendPerson_(ev){
  if(!/^\S+@\S+\.\S+$/.test(ev.to[1]))throw new Error('bad email '+ev.to[1]);
  MailApp.sendEmail({to:TEST_TO||ev.to[1],name:'IEEE Day 2026 Fayoum',subject:'IEEE Day 2026 – You are on bus '+ev.bus+' ('+ev.pt+')',
    htmlBody:'<div style="font-family:Arial;max-width:520px;margin:auto;border:1px solid #ddd;border-radius:14px;overflow:hidden"><div style="height:8px;background:linear-gradient(90deg,#00adef,#6abf4b,#f9a51a,#f58220,#93308f,#cc1a3e)"></div><div style="padding:20px"><h2 style="color:#0072bc;margin:0">IEEE Day 2026 · Fayoum</h2><p>Hello <b>'+esc_(ev.to[0])+'</b>,</p><p>You are confirmed on:</p><div style="background:#f2f7fc;border-radius:12px;padding:14px;font-size:18px">🚌 Bus: <b>'+esc_(ev.bus)+'</b><br>📍 Pickup: <b>'+esc_(ev.pt)+'</b><br>🕒 '+when_(ev.ts)+'<br>👤 Coordinator: <b>'+esc_(ev.by)+'</b></div><p>Please stay with this bus group and keep your ticket ID handy all day. Enjoy IEEE Day!</p></div></div>'});
}
function sendReport_(ev){
  const H=['Ticket ID','Name','Category','Branch','T-shirt','Email','Phone','Boarded','Confirmation email'];
  const csv=[H].concat(ev.rows).map(r=>r.map(c=>'"'+String(c==null?'':c).replace(/"/g,'""')+'"').join(',')).join('\n');
  const html='<div style="font-family:Arial"><h2 style="color:#0072bc">Bus '+esc_(ev.bus)+' ('+esc_(ev.pt)+') – confirmed</h2><p>Coordinator: <b>'+esc_(ev.by)+'</b> · '+when_(ev.ts)+' · <b>'+ev.rows.length+'</b> attendees</p><table border="1" cellpadding="5" style="border-collapse:collapse;font-size:13px"><tr style="background:#e3eef9">'+H.map(h=>'<th>'+h+'</th>').join('')+'</tr>'+ev.rows.map(r=>'<tr>'+r.map(c=>'<td>'+esc_(c)+'</td>').join('')+'</tr>').join('')+'</table><p>The CSV is attached.</p></div>';
  const to=TEST_TO||(ev.to||[]).join(',')||REPORT_CC;
  MailApp.sendEmail({to:to,cc:TEST_TO?undefined:(ev.to&&ev.to.length?REPORT_CC:undefined),name:'IEEE Day 2026 Fayoum',subject:'Bus '+ev.bus+' report – '+ev.rows.length+' attendees',htmlBody:html,attachments:[Utilities.newBlob('\ufeff'+csv,'text/csv','bus_'+ev.bus+'_report.csv')]});
}
function stat_(){const M=sh_('Mail',[]),n=M.getLastRow(),d=n>1?M.getRange(2,1,n-1,5).getValues():[],st={};d.forEach(r=>st[r[0]]=r[2]);
  return{sent:d.filter(r=>r[2]==='sent').length,fail:d.filter(r=>r[2]==='fail').length,todo:d.filter(r=>r[2]==='todo').length,quota:MailApp.getRemainingDailyQuota(),st:st,bad:d.filter(r=>r[2]==='fail').slice(-8).map(r=>r[1]+': '+r[4])}}
function cron(){const L=LockService.getScriptLock();if(!L.tryLock(20000))return;try{pump_(40)}finally{L.releaseLock()}}
function setup(){ScriptApp.getProjectTriggers().forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('cron').timeBased().everyMinutes(1).create();MailApp.getRemainingDailyQuota()}
